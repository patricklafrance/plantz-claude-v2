{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "defaultMode": "bypassPermissions",
        "allow": ["Edit(.claude/**)", "Write(.claude/**)"],
        "deny": ["Edit(**/.env)", "Write(**/.env)", "Edit(**/.env.*)", "Write(**/.env.*)"]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node agent-hooks/src/preflight/pre-tool-use.mjs"
                    },
                    {
                        "type": "command",
                        "command": "node agent-hooks/src/adlc-supervisor/pre-tool-use.mjs",
                        "timeout": 5000
                    }
                    // {
                    //     "type": "command",
                    //     "command": "node agent-hooks/src/pre-commit/pre-tool-use-bash.mjs",
                    //     "timeout": 180000,
                    // }
                ]
            },
            {
                "matcher": "Read",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node agent-hooks/src/preflight/pre-tool-use.mjs"
                    },
                    {
                        "type": "command",
                        "command": "node agent-hooks/src/adlc-supervisor/pre-tool-use.mjs",
                        "timeout": 5000
                    }
                ]
            },
            {
                "matcher": "Glob",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node agent-hooks/src/preflight/pre-tool-use.mjs"
                    }
                ]
            },
            {
                "matcher": "Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node agent-hooks/src/adlc-supervisor/pre-tool-use.mjs",
                        "timeout": 5000
                    }
                ]
            },
            {
                "matcher": "Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node agent-hooks/src/adlc-supervisor/pre-tool-use.mjs",
                        "timeout": 5000
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node agent-hooks/src/adlc-supervisor/post-tool-use.mjs",
                        "timeout": 5000
                    }
                ]
            }
        ],
        "PostToolUseFailure": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node agent-hooks/src/adlc-supervisor/post-tool-use.mjs",
                        "timeout": 5000
                    }
                ]
            }
        ],
        "PostCompact": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node agent-hooks/src/safe-compact/post-compact.mjs"
                    }
                ]
            }
        ],
        "SubagentStop": [
            {
                "matcher": "^_adlc-",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node agent-hooks/src/adlc-verification/subagent-stop.mjs",
                        "timeout": 180000
                    },
                    {
                        "type": "command",
                        "command": "node agent-hooks/src/adlc-supervisor/subagent-stop.mjs",
                        "timeout": 5000
                    }
                ]
            }
        ]
    }
}
